# Backend HTTP port.
PORT=5011
# Leave both database URIs unset locally to use the development memory databases.
# JWT signing secret for local development.
JWT_SECRET=dev_secret_1234567890
# JWT token lifetime.
JWT_EXPIRES_IN=7d
# Frontend origin allowed by the API.
CLIENT_URL=http://localhost:5173
# Enables the development-only MongoMemoryServer fallback when both URIs are absent.
NODE_ENV=development
