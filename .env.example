# Backend HTTP port.
PORT=5011
# Admin database connection string.
# Admin database connection string. Docker credentials are defined below.
ADMIN_MONGODB_URI=mongodb://csea:change-me@localhost:27017/csea_admin?authSource=admin
# Participant database connection string.
# Participant database connection string.
PARTICIPANT_MONGODB_URI=mongodb://csea:change-me@localhost:27018/csea_participant?authSource=admin
# MongoDB root credentials used by docker-compose.yml. Replace these values.
MONGO_INITDB_ROOT_USERNAME=csea
MONGO_INITDB_ROOT_PASSWORD=change-me
# Secret used to sign authentication tokens. Replace this value.
JWT_SECRET=replace_with_strong_secret
# JWT lifetime accepted by the authentication layer.
JWT_EXPIRES_IN=7d
# URL allowed to call the backend from the browser.
CLIENT_URL=http://localhost:5173
# Enables MongoMemoryServer fallback when both database URIs are absent.
NODE_ENV=development
